# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ArcGIS-ийн аппын ID — НУУЦ БИШ.
# Дээрх `.env*` дүрэм нь нууц үг, түлхүүрээс хамгаалах зорилготой бөгөөд
# энэ утга тэдний аль нь ч биш: `NEXT_PUBLIC_*` нь бүтээх үед хөтчийн
# багц руу ШУУД бичигддэг тул нийтлэгдсэн сайт нээсэн хэн бүхэнд аль
# хэдийн ил харагддаг. Хамгаалалтыг PKCE ба порталд бүртгэгдсэн буцах
# хаягийн ЯГ таарал хангана — бүртгээгүй хаяг руу портал
# `400 Invalid redirect_uri` буцаадгийг туршиж баталсан.
# Репод байснаар хөгжүүлэгч бүр гараар тохиргоо хийх шаардлагагүй болно;
# `.env.local` нь үүнийг үргэлж дарж бичнэ (өөр порталд туршихад).
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/public/maplibre/

# дев серверийн лог
.next-dev.log

# Хэлтсээс ирсэн боловсруулаагүй эх файл.
# `public/` доторх бүх зүйл статик экспортод хуулагдаж НИЙТЭД нээлттэй
# болдог бөгөөд эдгээр дэвтэр нь регистрийн дугаар, утасны дугаар,
# хувь хүний үнэлгээ агуулдаг. Зөвхөн боловсруулсан JSON нийтлэгдэнэ.
/sources/
public/data/*.xlsx
public/data/~$*

# Серверийн НИЙТИЙН TLS гэрчилгээ — хувийн түлхүүр БИШ.
# `environment.ub.gov.mn` нь өөрөө гарын үсэг зурсан гэрчилгээтэй тул
# `scripts/log-weather.mjs` түүнийг итгэмжлэгдсэн CA болгож бэхэлдэг
# (`NODE_EXTRA_CA_CERTS`). Дээрх `*.pem` дүрэм нь хувийн түлхүүрээс
# хамгаалах зорилготой — гэрчилгээ нь аль ч хөтөч татаж авдаг нийтийн
# мэдээлэл тул хамаарахгүй.
!scripts/environment-ub-gov-mn.pem

# Дотоод сүлжээнд ажиллах архивын нууц утгууд ба түүний лог
/scripts/weather-secrets.cmd
/logs/
